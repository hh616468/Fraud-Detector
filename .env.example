# Copy to .env and adjust. .env is git-ignored.

# OpenAI-compatible endpoint (vLLM) serving the coaching model
LLM_BASE_URL=http://localhost:8070/v1
LLM_MODEL=google/gemma-4-31B-it
LLM_API_KEY=EMPTY

# Seconds the app waits for an LLM coaching turn before keeping the reviewed template.
# The deck's target is p95 <= 3 s; Gemma-4-31B measured ~5 s per turn, so the demo default is 8.
COACH_TIMEOUT_S=8

# Seconds Proceed stays locked at the coaching tier
PROCEED_LOCK_S=20

# SQLite file for the mock wallet, assessments and audit log
DB_PATH=var/wallet.db

# HMAC key used to pseudonymise user ids in the audit log and reviewer view
AUDIT_PSEUDONYM_KEY=change-me
